<?xml version="1.0" encoding="utf-8"?>
<!--
  AcessaCidade.RPA - Workflows/RegistrarResultado.xaml
  Grava Status_Robo, Protocolo, Mensagem e Data_Hora_Processamento na linha processada e salva a
  tabela inteira na planilha de saida (a cada linha, para nao perder o progresso se o robo parar).
-->
<Activity mc:Ignorable="sap sap2010" x:Class="RegistrarResultado" mva:VisualBasic.Settings="{x:Null}"
 sap2010:WorkflowViewState.IdRef="ActivityBuilder_1"
 xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 xmlns:mva="clr-namespace:Microsoft.VisualBasic.Activities;assembly=System.Activities"
 xmlns:s="clr-namespace:System;assembly=System.Private.CoreLib"
 xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
 xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
 xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib"
 xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=System.Private.CoreLib"
 xmlns:sd="clr-namespace:System.Data;assembly=System.Data.Common"
 xmlns:ui="http://schemas.uipath.com/workflow/activities"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="io_Tabela" Type="InOutArgument(sd:DataTable)" />
    <x:Property Name="in_IndiceLinha" Type="InArgument(x:Int32)" />
    <x:Property Name="in_Status" Type="InArgument(x:String)" />
    <x:Property Name="in_Protocolo" Type="InArgument(x:String)" />
    <x:Property Name="in_Mensagem" Type="InArgument(x:String)" />
    <x:Property Name="in_CaminhoSaida" Type="InArgument(x:String)" />
    <x:Property Name="in_AbaSaida" Type="InArgument(x:String)" />
  </x:Members>
  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>System</x:String>
      <x:String>System.Activities</x:String>
      <x:String>System.Activities.Statements</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.Collections.ObjectModel</x:String>
      <x:String>System.Data</x:String>
      <x:String>System.IO</x:String>
      <x:String>System.Linq</x:String>
      <x:String>Microsoft.VisualBasic</x:String>
      <x:String>UiPath.Core</x:String>
      <x:String>UiPath.Core.Activities</x:String>
      <x:String>UiPath.Excel</x:String>
      <x:String>UiPath.Excel.Activities</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>Microsoft.VisualBasic</AssemblyReference>
      <AssemblyReference>System</AssemblyReference>
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>System.Data</AssemblyReference>
      <AssemblyReference>System.Data.Common</AssemblyReference>
      <AssemblyReference>System.Linq</AssemblyReference>
      <AssemblyReference>System.Private.CoreLib</AssemblyReference>
      <AssemblyReference>System.Runtime</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
      <AssemblyReference>UiPath.Excel.Activities</AssemblyReference>
      <AssemblyReference>UiPath.Excel</AssemblyReference>
      <AssemblyReference>UiPath.Workflow</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="Registrar resultado na planilha de saída" sap2010:WorkflowViewState.IdRef="Sequence_1"
   sap2010:Annotation.AnnotationText="Atualiza as colunas de saída da linha in_IndiceLinha e grava a tabela completa (com cabeçalhos) na aba de saída. A planilha de saída deve estar FECHADA no Excel.">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="abaSaida" />
      <Variable x:TypeArguments="x:String" Name="mensagemCurta" />
    </Sequence.Variables>
    <Assign DisplayName="abaSaida" sap2010:WorkflowViewState.IdRef="Assign_1">
      <Assign.To><OutArgument x:TypeArguments="x:String">[abaSaida]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:String">[If(String.IsNullOrWhiteSpace(in_AbaSaida), "Resultado", in_AbaSaida)]</InArgument></Assign.Value>
    </Assign>
    <Assign DisplayName="mensagemCurta (até 500 caracteres)" sap2010:WorkflowViewState.IdRef="Assign_2"
     sap2010:Annotation.AnnotationText="Limita o tamanho da mensagem para a célula continuar legível.">
      <Assign.To><OutArgument x:TypeArguments="x:String">[mensagemCurta]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:String">[If(If(in_Mensagem, "").Length &gt; 500, in_Mensagem.Substring(0, 500), If(in_Mensagem, ""))]</InArgument></Assign.Value>
    </Assign>
    <Assign DisplayName="Status_Robo" sap2010:WorkflowViewState.IdRef="Assign_3"
     sap2010:Annotation.AnnotationText="SUCESSO, FALHA_NEGOCIO ou FALHA_SISTEMA.">
      <Assign.To><OutArgument x:TypeArguments="x:Object">[io_Tabela.Rows(in_IndiceLinha)("Status_Robo")]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:Object">[in_Status]</InArgument></Assign.Value>
    </Assign>
    <Assign DisplayName="Protocolo" sap2010:WorkflowViewState.IdRef="Assign_4"
     sap2010:Annotation.AnnotationText="Protocolo capturado de #protocolo-gerado (vazio em caso de falha).">
      <Assign.To><OutArgument x:TypeArguments="x:Object">[io_Tabela.Rows(in_IndiceLinha)("Protocolo")]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:Object">[If(in_Protocolo, "")]</InArgument></Assign.Value>
    </Assign>
    <Assign DisplayName="Mensagem" sap2010:WorkflowViewState.IdRef="Assign_5">
      <Assign.To><OutArgument x:TypeArguments="x:Object">[io_Tabela.Rows(in_IndiceLinha)("Mensagem")]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:Object">[mensagemCurta]</InArgument></Assign.Value>
    </Assign>
    <Assign DisplayName="Data_Hora_Processamento" sap2010:WorkflowViewState.IdRef="Assign_6">
      <Assign.To><OutArgument x:TypeArguments="x:Object">[io_Tabela.Rows(in_IndiceLinha)("Data_Hora_Processamento")]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:Object">[DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")]</InArgument></Assign.Value>
    </Assign>
    <ui:WriteRange AddHeaders="True" DataTable="[io_Tabela]" DisplayName="Write Range Workbook - planilha de saída" SheetName="[abaSaida]" StartingCell="A1" WorkbookPath="[in_CaminhoSaida]"
     sap2010:WorkflowViewState.IdRef="WriteRange_1"
     sap2010:Annotation.AnnotationText="Workbook Write Range: cria o arquivo se não existir e sobrescreve a aba a partir de A1. Gravar a cada linha preserva o progresso se o robô for interrompido." />
    <ui:LogMessage DisplayName="Log - resultado gravado" Level="Info" sap2010:WorkflowViewState.IdRef="LogMessage_1"
     Message="[&quot;Linha &quot; + (in_IndiceLinha + 1).ToString + &quot; -&gt; &quot; + in_Status + &quot; &quot; + If(in_Protocolo, &quot;&quot;) + &quot; (gravado em &quot; + in_CaminhoSaida + &quot;)&quot;]" />
  </Sequence>
</Activity>
