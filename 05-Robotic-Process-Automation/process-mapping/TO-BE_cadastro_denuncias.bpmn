        <dc:Bounds x="180" y="280" width="3070" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_ToBe_Robo_di" bpmnElement="Lane_ToBe_Robo" isHorizontal="true">
        <dc:Bounds x="180" y="480" width="3070" height="330" />
      </bpmndi:BPMNShape>
