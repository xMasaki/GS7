<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ToBe" targetNamespace="http://bpmn.io/schema/bpmn" exporter="AcessaCidade gerar_bpmn.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_ToBe">
    <bpmn:participant id="Participant_ToBe" name="TO-BE — Cadastro automatizado pelo robô UiPath (operador trata exceções)" processRef="Process_ToBe" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ToBe" name="TO-BE — Cadastro automatizado pelo robô UiPath (operador trata exceções)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ToBe">
      <bpmn:lane id="Lane_ToBe_Associacao" name="Cidadão / Associação">
        <bpmn:flowNodeRef>Start_ToBe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ToBe_Preencher</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ToBe_Enviar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ToBe_Receber</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ToBe</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ToBe_Operador" name="Operador AcessaCidade">
        <bpmn:flowNodeRef>Task_ToBe_Iniciar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ToBe_Excecoes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ToBe_Informar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ToBe_Robo" name="Robô UiPath (AcessaCidade.RPA)">
        <bpmn:flowNodeRef>Task_ToBe_Config</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ToBe_Ler</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ToBe_Validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ToBe_Valida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ToBe_Formulario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ToBe_Protocolo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ToBe_Sucesso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ToBe_Falha</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ToBe_Mais</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ToBe_Resumo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ToBe_Sistema" name="AcessaCidade (web)">
        <bpmn:flowNodeRef>Task_ToBe_Registrar</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_ToBe" name="Denúncias coletadas pela associação">
      <bpmn:outgoing>Flow_ToBe_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="Task_ToBe_Preencher" name="Preencher a planilha-modelo padronizada">
      <bpmn:incoming>Flow_ToBe_01</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_02</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sendTask id="Task_ToBe_Enviar" name="Enviar a planilha ao AcessaCidade">
      <bpmn:incoming>Flow_ToBe_02</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_03</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Task_ToBe_Iniciar" name="Salvar planilha na pasta de entrada e iniciar o robô">
      <bpmn:incoming>Flow_ToBe_03</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_ToBe_Config" name="Carregar configuração (Config.xlsx)">
      <bpmn:incoming>Flow_ToBe_04</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ToBe_Ler" name="Ler planilha de entrada (Read Range)">
      <bpmn:incoming>Flow_ToBe_05</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ToBe_Validar" name="Validar a linha (regras e rótulos do contrato)">
      <bpmn:incoming>Flow_ToBe_06</bpmn:incoming>
      <bpmn:incoming>Flow_ToBe_16</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_ToBe_Valida" name="Linha válida?">
      <bpmn:incoming>Flow_ToBe_07</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_08</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToBe_09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ToBe_Formulario" name="Preencher e enviar #/registrar?canal=rpa">
      <bpmn:incoming>Flow_ToBe_08</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ToBe_Registrar" name="Validar, registrar (origem=RPA) e gerar protocolo">
      <bpmn:incoming>Flow_ToBe_10</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_ToBe_Protocolo" name="Protocolo capturado?">
      <bpmn:incoming>Flow_ToBe_11</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToBe_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ToBe_Sucesso" name="Gravar SUCESSO e protocolo na planilha de saída">
      <bpmn:incoming>Flow_ToBe_12</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ToBe_Falha" name="Gravar FALHA_NEGOCIO ou FALHA_SISTEMA e mensagem">
      <bpmn:incoming>Flow_ToBe_09</bpmn:incoming>
      <bpmn:incoming>Flow_ToBe_13</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_ToBe_Mais" name="Há mais linhas?">
      <bpmn:incoming>Flow_ToBe_14</bpmn:incoming>
      <bpmn:incoming>Flow_ToBe_15</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToBe_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ToBe_Resumo" name="Gerar resumo com totais (log)">
      <bpmn:incoming>Flow_ToBe_17</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_ToBe_Excecoes" name="Tratar somente as exceções (FALHA_*)">
      <bpmn:incoming>Flow_ToBe_18</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_ToBe_Informar" name="Enviar planilha de saída com protocolos à associação">
      <bpmn:incoming>Flow_ToBe_19</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_20</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_ToBe_Receber" name="Receber protocolos para acompanhamento">
      <bpmn:incoming>Flow_ToBe_20</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_21</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="End_ToBe" name="Denúncias registradas e protocolos entregues">
      <bpmn:incoming>Flow_ToBe_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToBe_01" sourceRef="Start_ToBe" targetRef="Task_ToBe_Preencher" />
    <bpmn:sequenceFlow id="Flow_ToBe_02" sourceRef="Task_ToBe_Preencher" targetRef="Task_ToBe_Enviar" />
    <bpmn:sequenceFlow id="Flow_ToBe_03" sourceRef="Task_ToBe_Enviar" targetRef="Task_ToBe_Iniciar" />
    <bpmn:sequenceFlow id="Flow_ToBe_04" sourceRef="Task_ToBe_Iniciar" targetRef="Task_ToBe_Config" />
    <bpmn:sequenceFlow id="Flow_ToBe_05" sourceRef="Task_ToBe_Config" targetRef="Task_ToBe_Ler" />
    <bpmn:sequenceFlow id="Flow_ToBe_06" sourceRef="Task_ToBe_Ler" targetRef="Task_ToBe_Validar" />
    <bpmn:sequenceFlow id="Flow_ToBe_07" sourceRef="Task_ToBe_Validar" targetRef="Gateway_ToBe_Valida" />
    <bpmn:sequenceFlow id="Flow_ToBe_08" name="Sim" sourceRef="Gateway_ToBe_Valida" targetRef="Task_ToBe_Formulario" />
    <bpmn:sequenceFlow id="Flow_ToBe_09" name="Não" sourceRef="Gateway_ToBe_Valida" targetRef="Task_ToBe_Falha" />
    <bpmn:sequenceFlow id="Flow_ToBe_10" sourceRef="Task_ToBe_Formulario" targetRef="Task_ToBe_Registrar" />
    <bpmn:sequenceFlow id="Flow_ToBe_11" sourceRef="Task_ToBe_Registrar" targetRef="Gateway_ToBe_Protocolo" />
    <bpmn:sequenceFlow id="Flow_ToBe_12" name="Sim" sourceRef="Gateway_ToBe_Protocolo" targetRef="Task_ToBe_Sucesso" />
    <bpmn:sequenceFlow id="Flow_ToBe_13" name="Não (erro/tempo)" sourceRef="Gateway_ToBe_Protocolo" targetRef="Task_ToBe_Falha" />
    <bpmn:sequenceFlow id="Flow_ToBe_14" sourceRef="Task_ToBe_Sucesso" targetRef="Gateway_ToBe_Mais" />
    <bpmn:sequenceFlow id="Flow_ToBe_15" sourceRef="Task_ToBe_Falha" targetRef="Gateway_ToBe_Mais" />
    <bpmn:sequenceFlow id="Flow_ToBe_16" name="Sim" sourceRef="Gateway_ToBe_Mais" targetRef="Task_ToBe_Validar" />
    <bpmn:sequenceFlow id="Flow_ToBe_17" name="Não" sourceRef="Gateway_ToBe_Mais" targetRef="Task_ToBe_Resumo" />
    <bpmn:sequenceFlow id="Flow_ToBe_18" sourceRef="Task_ToBe_Resumo" targetRef="Task_ToBe_Excecoes" />
    <bpmn:sequenceFlow id="Flow_ToBe_19" sourceRef="Task_ToBe_Excecoes" targetRef="Task_ToBe_Informar" />
    <bpmn:sequenceFlow id="Flow_ToBe_20" sourceRef="Task_ToBe_Informar" targetRef="Task_ToBe_Receber" />
    <bpmn:sequenceFlow id="Flow_ToBe_21" sourceRef="Task_ToBe_Receber" targetRef="End_ToBe" />
    <bpmn:textAnnotation id="Annotation_ToBe_Inicio">
      <bpmn:text>Futuro: disparo agendado (Orchestrator ou Agendador do Windows).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Annotation_ToBe_Inicio" associationDirection="None" sourceRef="Annotation_ToBe_Inicio" targetRef="Task_ToBe_Iniciar" />
    <bpmn:textAnnotation id="Annotation_ToBe_Seletores">
      <bpmn:text>Seletores pelos ids estáveis do contrato (seção 7).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Annotation_ToBe_Seletores" associationDirection="None" sourceRef="Annotation_ToBe_Seletores" targetRef="Task_ToBe_Formulario" />
    <bpmn:textAnnotation id="Annotation_ToBe_Excecoes">
      <bpmn:text>Operador só atua nas linhas com FALHA_* (corrige e reprocessa).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Annotation_ToBe_Excecoes" associationDirection="None" sourceRef="Annotation_ToBe_Excecoes" targetRef="Task_ToBe_Excecoes" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ToBe">
    <bpmndi:BPMNPlane id="BPMNPlane_ToBe" bpmnElement="Collaboration_ToBe">
      <bpmndi:BPMNShape id="Participant_ToBe_di" bpmnElement="Participant_ToBe" isHorizontal="true">
        <dc:Bounds x="150" y="80" width="3100" height="930" />
      </bpmndi:BPMNShape>
